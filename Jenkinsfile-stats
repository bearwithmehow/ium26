pipeline {
    agent {
        docker { 
            image 'bearwithmehow/ium:v1.2' 
        }
    }

    stages {
        stage('checkout: Check out from version control') {
            steps {
                checkout scm
            }
        }

        stage('copy: Copy artifacts from Create Dataset') {
            steps {
                copyArtifacts(
                    projectName: 'create-dataset',
                    filter: 'artifacts/**/*',                   
                    target: ''                             
                )
            }
        }

        stage('stats: Calculate dataset statistics') {
            steps {
                sh 'python3 dataset-stats.py' 
            }
        }

    }
}